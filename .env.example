NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=zuri_os
JWT_ISSUER=https://identity.zurios.local
JWT_AUDIENCE=zuri-os-api
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=2592000
MFA_ENCRYPTION_KEY=base64-encode-a-random-32-byte-key
CORS_ORIGINS=http://localhost:5173

# Optional dedicated webhook worker process settings
WEBHOOK_WORKER_ID=zuri-webhook-worker-1
WEBHOOK_WORKER_BATCH_SIZE=20
WEBHOOK_WORKER_POLL_INTERVAL_MS=2000
# Inject signing secrets through the deployment secret manager; never commit values.
# Store env://ZURI_WEBHOOK_SECRET_<NAME> as the webhook secretRef.
ZURI_WEBHOOK_SECRET_EXAMPLE=replace-with-at-least-32-random-characters
