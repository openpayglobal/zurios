NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=zuri_os
JWT_ISSUER=https://identity.zurios.local
JWT_AUDIENCE=zuri-os-api
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=2592000
MFA_ENCRYPTION_KEY=base64-encode-a-random-32-byte-key
# Independent MAC/MAD operator authentication; never reuse JWT_SECRET.
MAC_JWT_SECRET=replace-with-a-different-long-random-secret
# One-time bootstrap credential; remove from deployment after initial owner activation.
MAC_BOOTSTRAP_TOKEN=replace-with-a-one-time-high-entropy-token
MAC_MFA_ENCRYPTION_KEY=base64-encode-a-separate-random-32-byte-key
MAC_SESSION_TTL_SECONDS=28800
# Frontend build-time API origin; set in apps/web deployment environment.
VITE_ZURI_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
