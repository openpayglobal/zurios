# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000

# Use a MongoDB replica set locally or a replica-set/sharded Atlas cluster.
# Multi-document transactions are required by tenant bootstrap and signed audit writes.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=zuri_os

# Generate a unique secret for each environment (at least 32 characters).
JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=zuri-os-api
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=2592000

# Optional in development; production requires a base64-encoded 32-byte key.
MFA_ENCRYPTION_KEY=

# Exact comma-separated browser origins; do not use wildcard origins with credentials.
CORS_ORIGINS=http://localhost:5173
