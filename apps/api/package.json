{
  "name": "@zuri/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @zuri/core-platform build && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "openapi:check": "tsx scripts/check-openapi-route-drift.ts",
    "bootstrap:platform-operator": "tsx scripts/bootstrap-platform-operator.ts",
    "test": "tsx --test src/platform/*.test.ts src/platform/*.integration.test.ts",
    "demo:seed": "tsx scripts/seed-demo-accounts.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@zuri/core-platform": "workspace:*",
    "argon2": "^0.41.1",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "mongodb": "^6.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
