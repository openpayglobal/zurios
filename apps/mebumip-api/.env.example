# Zuri MeBuMIP API — local development only.
# Never commit real credentials. Production configuration belongs in the deployment secret store.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=zuri_mebumip
CORS_ORIGINS=http://localhost:5174
SESSION_TTL_HOURS=24
SESSION_COOKIE_SAME_SITE=Lax
# Set only when the service is behind explicitly trusted reverse proxies.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Generate a random bootstrap token; remove it after first-owner setup.
# PLATFORM_BOOTSTRAP_TOKEN=

# Generate a 32-byte key with: openssl rand -hex 32
# MFA_ENCRYPTION_KEY=
# Or use a rotation keyring:
# MFA_ENCRYPTION_KEYRING={"mfa-2026-01":"REPLACE_WITH_64_HEX_CHARS"}
# MFA_ENCRYPTION_ACTIVE_KEY_ID=mfa-2026-01

# Use a dedicated random signing key. Production must retain the legacy key
# while historical audit records still use the original signature format.
AUDIT_SIGNING_KEY=local-development-only-change-me-before-deployment
# AUDIT_SIGNING_KEYRING={"legacy":"REPLACE_WITH_LEGACY_HEX_KEY","audit-2026-01":"REPLACE_WITH_64_HEX_CHARS"}
# AUDIT_SIGNING_ACTIVE_KEY_ID=audit-2026-01
# Apply-only, ephemeral maintenance connection; never configure this on the runtime API service.
# AUDIT_MIGRATION_MONGODB_URI=

# Production requires both values; local mail delivery remains unconfigured.
# RESEND_API_KEY=
# MAIL_FROM=

# Meta integration remains disabled until a reviewed Meta app is configured.
# Production requires APP ID + secret + HTTPS redirect URI + explicit API version
# + a dedicated token-encryption keyring. Never reuse MFA or audit keys.
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=https://api.example.com/v1/meta/oauth/callback
# META_GRAPH_API_VERSION=v27.0
# META_MARKETING_API_VERSION=v27.0
# META_WEBHOOK_VERIFY_TOKEN=
# META_TOKEN_ENCRYPTION_KEYRING={"meta-2026-01":"REPLACE_WITH_64_HEX_CHARS"}
# META_TOKEN_ENCRYPTION_ACTIVE_KEY_ID=meta-2026-01
