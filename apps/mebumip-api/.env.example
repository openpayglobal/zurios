NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=zuri_mebumip
CORS_ORIGINS=http://localhost:5174
SESSION_TTL_HOURS=24
# Optional: generate a cryptographically secure random 32-byte value, hex-encoded.
# MFA_ENCRYPTION_KEY=<64-hex-character-secret>
# Required only for the one-time first-owner bootstrap; remove after setup.
# PLATFORM_BOOTSTRAP_TOKEN=<random-secret-at-least-32-characters>

# Resend delivery configuration; required in production. Store values in a secret manager.
# RESEND_API_KEY=<resend-api-key>
# MAIL_FROM=no-reply@your-verified-domain.example
# AUDIT_SIGNING_KEY=<at-least-32-character-random-secret>

# Optional: SameSite cookie policy (Strict, Lax, or None; None is for cross-site HTTPS deployments).
# SESSION_COOKIE_SAME_SITE=Lax
# Optional: comma-separated trusted reverse-proxy IPs/CIDRs. Do not trust arbitrary forwarded headers.
# TRUSTED_PROXY_CIDRS=127.0.0.1,10.0.0.0/8
